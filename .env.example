# =====================================================================
# AI-Based Traffic Prediction System with MLOps - Environment Variables
# =====================================================================

# FastAPI Serving Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Streamlit Dashboard Configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=traffic-prediction-lstm

# Model Artifact Locations
MODEL_PATH=models/traffic_lstm.keras
FEATURE_SCALER_PATH=models/feature_scaler.pkl
TARGET_SCALER_PATH=models/target_scaler.pkl

# Retraining Promotion Thresholds
MAX_ALLOWED_RMSE_INCREASE=0.0
MIN_REQUIRED_R2_SCORE=0.85
